# Supabase project (Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Web Push public key (generate with: npx web-push generate-vapid-keys)
# Optional: the app fetches the push key from Supabase if this is empty
VITE_VAPID_PUBLIC_KEY=

# Optional: make every flight take one minute while testing
VITE_QUICK_FLIGHTS=false
