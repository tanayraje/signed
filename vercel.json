{
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/((?!assets/|sw.js|manifest.webmanifest|workbox-|privacy|terms).*)",
      "destination": "/index.html"
    }
  ]
}